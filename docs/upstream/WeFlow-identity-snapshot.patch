+  /** Fresh, read-only identities. Never use contactsMemoryCache or avatarCache. */
+  private async readFreshIdentitySnapshot(): Promise<FreshIdentitySnapshotResult> {
+    try {
+      const connected = await this.ensureConnected()
+      if (!connected.success) return { success: false, error: connected.error }
+      const accountScope = this.getCacheAccountScope()
+      const epoch = this.accountCacheEpoch
+      // A fixed SELECT performs a fresh contact.db read; no arbitrary client SQL.
+      const contactResult = await wcdbService.execQuery('contact', null, 'SELECT * FROM contact')
+      if (!this.isAccountCacheContextCurrent(accountScope, epoch)) {
+        return { success: false, error: 'Account changed during identity snapshot' }
+      }
+      if (!contactResult.success || !Array.isArray(contactResult.rows)) {
+        return { success: false, error: contactResult.error || 'Fresh contacts unavailable' }
+      }
+      const sessionResult = await wcdbService.getSessions()
+      if (!this.isAccountCacheContextCurrent(accountScope, epoch)) {
+        return { success: false, error: 'Account changed during identity snapshot' }
+      }
+      if (!sessionResult.success || !Array.isArray(sessionResult.sessions)) {
+        return { success: false, error: sessionResult.error || 'Fresh sessions unavailable' }
+      }
+      const validIdentity = (value: unknown): value is string => typeof value === 'string' &&
+        /^[A-Za-z0-9_.@:-]{1,256}$/.test(value) && !['unknown', 'null', 'None'].includes(value)
+      const text = (row: Record<string, any>, fields: string[]): string => {
+        const value = this.getRowField(row, fields)
+        return typeof value === 'string' ? value : ''
+      }
+      const contacts: ContactInfo[] = []
+      const names = new Map<string, string>()
+      for (const row of contactResult.rows as Record<string, any>[]) {
+        const username = text(row, ['username', 'user_name', 'userName'])
+        if (!validIdentity(username)) continue
+        const remark = text(row, ['remark', 'WCDB_CT_remark'])
+        const nickname = text(row, ['nick_name', 'nickName', 'nickname', 'NickName', 'WCDB_CT_nick_name'])
+        const alias = text(row, ['alias', 'WCDB_CT_alias'])
+        const displayName = remark || nickname || alias || username
+        contacts.push({ username, displayName, remark, nickname, alias,
+          type: username.endsWith('@chatroom') ? 'group' : 'friend' })
+        names.set(username, displayName)
+      }
+      const sessions: Array<{ username: string; displayName: string; type: number }> = []
+      for (const row of sessionResult.sessions as Record<string, any>[]) {
+        const username = text(row, ['username', 'user_name', 'userName'])
+        if (!validIdentity(username)) continue
+        // A missing contact remains an ID, never a cached/nickname identity guess.
+        sessions.push({ username, displayName: names.get(username) || username,
+          type: username.endsWith('@chatroom') ? 2 : 1 })
+      }
+      contacts.sort((a, b) => a.username.localeCompare(b.username))
+      sessions.sort((a, b) => a.username.localeCompare(b.username))
+      return { success: true, contacts, sessions }
+    } catch (error) {
+      return { success: false, error: String(error) }
+    }
+  }
