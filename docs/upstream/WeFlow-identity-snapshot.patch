+  /** Versioned fresh snapshot extension, behind the existing API token check. */
+  private async handleIdentitySnapshot(req: http.IncomingMessage, res: http.ServerResponse): Promise<void> {
+    const result = await chatService.getFreshIdentitySnapshot()
+    if (!result.success || !result.contacts || !result.sessions) {
+      this.sendError(res, 503, result.error || 'Fresh identity snapshot unavailable')
+      return
+    }
+    const revision = createHash('sha256').update(JSON.stringify({
+      contacts: result.contacts, sessions: result.sessions
+    })).digest('hex')
+    const etag = `"${revision}"`
+    res.setHeader('ETag', etag)
+    res.setHeader('Cache-Control', 'no-store')
+    res.setHeader('X-WeFlow-Identity-Snapshot', '1')
+    // Read the DB first even for a conditional request; never answer from a cache.
+    if (req.headers['if-none-match'] === etag) {
+      res.writeHead(304)
+      res.end()
+      return
+    }
+    this.sendJson(res, { success: true, version: 1, fresh: true,
+      capabilities: { freshIdentitySnapshot: 1 }, snapshotAt: Date.now(), revision,
+      contacts: result.contacts, sessions: result.sessions })
+  }
