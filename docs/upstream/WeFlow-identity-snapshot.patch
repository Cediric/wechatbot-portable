+  /** One underlying read and one deadline, even when the native worker hangs. */
+  getFreshIdentitySnapshot(): Promise<FreshIdentitySnapshotResult> {
+    if (this.identitySnapshotInFlight) return this.identitySnapshotInFlight
+    const work = this.readFreshIdentitySnapshot()
+    let timer: ReturnType<typeof setTimeout> | undefined
+    const reply = new Promise<FreshIdentitySnapshotResult>(resolve => {
+      timer = setTimeout(() => resolve({ success: false, error: 'Fresh identity query timed out' }), 2500)
+      void work.then(result => { clearTimeout(timer); resolve(result) }, error => {
+        clearTimeout(timer)
+        resolve({ success: false, error: String(error) })
+      })
+    })
+    this.identitySnapshotInFlight = reply
+    // Keep the settled deadline reply until the actual native read finishes. A
+    // later request must not add another worker RPC or reaction to a hung work.
+    void work.finally(() => {
+      clearTimeout(timer)
+      if (this.identitySnapshotInFlight === reply) this.identitySnapshotInFlight = null
+    }).catch(() => {})
+    return reply
+  }
